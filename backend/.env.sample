PORT=5000
# Add your MongoDB connection string here
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.../

# LLM API Keys (Groq is used for Executor, Gemini for Planner/Responder)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI/Sarvam keys if using alternative embeddings or models
OPENAI_API_KEY=sk-your_openai_api_key_here
SARVAM_API_KEY=sk_your_sarvam_api_key_here

# Razorpay Test Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
